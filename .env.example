# =============================================================================
# Manus Web Agent - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# API Key for LLM provider (OpenAI, DeepSeek, etc.)
LLM_API_KEY=your_api_key_here

# Base URL for LLM API (optional, defaults to OpenAI)
LLM_BASE_URL=https://api.deepseek.com

# Model name to use
LLM_MODEL=deepseek-chat

# Temperature (0.0 - 2.0)
LLM_TEMPERATURE=0.7

# Max tokens per request
LLM_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# MongoDB connection URL
MONGODB_URL=mongodb://localhost:27017

# MongoDB database name
MONGODB_DATABASE=manus_web_agent

# MongoDB username (optional)
# MONGODB_USERNAME=

# MongoDB password (optional)
# MONGODB_PASSWORD=

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Redis password (optional)
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# JWT secret key (generate a secure random key for production)
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# Access token expiration (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token expiration (days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Sandbox Configuration
# -----------------------------------------------------------------------------
# Docker image for sandbox
SANDBOX_IMAGE=simpleyyt/manus-sandbox

# Sandbox container name prefix
SANDBOX_NAME_PREFIX=manus-sandbox

# Sandbox TTL (minutes)
SANDBOX_TTL_MINUTES=30

# Docker network for sandbox
# SANDBOX_NETWORK=manus-network

# Chrome arguments for sandbox
# SANDBOX_CHROME_ARGS=

# Proxy settings (optional)
# SANDBOX_HTTPS_PROXY=
# SANDBOX_HTTP_PROXY=
# SANDBOX_NO_PROXY=

# -----------------------------------------------------------------------------
# Search Configuration
# -----------------------------------------------------------------------------
# Search provider: bing, google, baidu
SEARCH_PROVIDER=bing

# Google Search API Key (required if using Google)
# GOOGLE_SEARCH_API_KEY=

# Google Search Engine ID (required if using Google)
# GOOGLE_SEARCH_ENGINE_ID=

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Host to bind
HOST=0.0.0.0

# Port to bind
PORT=8000

# Enable auto-reload (development only)
RELOAD=false
